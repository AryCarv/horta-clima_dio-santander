# Supabase Configuration
# Get these from your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key (or VITE_SUPABASE_ANON_KEY for older keys)

# Server-side (for migrations, admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LOVABLE_DB_MIGRATION_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres